{
  "manifest_version": 3,
  "name": "APIGarden",
  "version": "1.5.0",
  "description": "Record browser workflows and export live visible product results with names, prices, images, and links as JSON.",
  "action": {
    "default_title": "APIGarden",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}