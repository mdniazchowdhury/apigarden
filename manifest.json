{
  "manifest_version": 3,
  "name": "APIGarden",
  "version": "1.3.0",
  "description": "Generate, test, and monetize APIs with a secure AI backend.",
  "action": {
    "default_title": "APIGarden",
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}