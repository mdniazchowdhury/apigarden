{
  "manifest_version": 3,
  "name": "APIGarden",
  "version": "1.3.0",
  "description": "Generate, test, and monetize APIs with a secure AI backend.",
  "action": {
    "default_title": "APIGarden",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://api.frankfurter.app/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ]
}
