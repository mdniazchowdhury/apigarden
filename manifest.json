{
  "manifest_version": 3,
  "name": "APIGarden",
  "version": "1.9.1",
  "description": "APIGarden Voice Browser Agent with improved live catalog extraction for dynamic ecommerce pages such as Daraz, plus JSON export, API saving, and browser automation.",
  "action": {
    "default_title": "APIGarden",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
